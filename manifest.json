{
  "manifest_version": 3,
  "name": "重点关注 · B站续播清单",
  "version": "1.3.0",
  "description": "独立的本机 B站关注清单，按分P记录观看位置和时间点书签。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://*.bilibili.com/*", "https://*.hdslb.com/*", "https://b23.tv/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "重点关注", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{ "matches": ["https://www.bilibili.com/video/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
